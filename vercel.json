    { "source": "/sofa-cleaning-gurugram", "destination": "/sofa-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/blanket-cleaning-gurugram", "destination": "/blanket-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/curtain-cleaning-gurugram", "destination": "/curtain-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/shoe-cleaning-gurugram", "destination": "/shoe-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/wedding-dress-cleaning-gurugram", "destination": "/wedding-dress-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/carpet-cleaning-gurugram", "destination": "/carpet-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/suit-dry-cleaning-gurugram", "destination": "/suit-dry-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/steam-ironing-gurugram", "destination": "/steam-ironing-gurugram.html", "statusCode": 301 },
    { "source": "/leather-bag-cleaning-gurugram", "destination": "/leather-bag-cleaning-gurugram.html", "statusCode": 301 },
    { "source": "/commercial-laundry-gurugram", "destination": "/commercial-laundry-gurugram.html", "statusCode": 301 },
    { "source": "/dry-cleaner-dlf-gurugram", "destination": "/dry-cleaner-dlf-gurugram.html", "statusCode": 301 },
    { "source": "/dry-cleaner-golf-course-road", "destination": "/dry-cleaner-golf-course-road.html", "statusCode": 301 },
